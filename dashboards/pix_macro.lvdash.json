        {
          "widget": {
            "name": "pix_vs_selic",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_indicadores",
                  "fields": [
                    {"name": "monthly(data_referencia)", "expression": "DATE_TRUNC(\"MONTH\", `data_referencia`)"},
                    {"name": "sum(pix_valor)", "expression": "SUM(`pix_valor`)"},
                    {"name": "avg(selic_media)", "expression": "AVG(`selic_media`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "combo",
              "encodings": {
                "x": {"fieldName": "monthly(data_referencia)", "scale": {"type": "temporal"}, "displayName": "Mes"},
                "y": {
                  "scale": {"type": "quantitative"},
                  "primary": {
                    "fields": [
                      {"fieldName": "sum(pix_valor)", "displayName": "Valor movimentado via Pix (R$)",
                       "format": {"type": "number-currency", "currencyCode": "BRL", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 1}}}
                    ]
                  },
                  "secondary": {
                    "fields": [
                      {"fieldName": "avg(selic_media)", "displayName": "Meta Selic (media do mes)",
                       "format": {"type": "number-percent", "decimalPlaces": {"type": "max", "places": 2}}}
                    ]

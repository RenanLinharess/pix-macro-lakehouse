                },
                "label": {"show": false}
              },
              "frame": {"title": "O Pix cresceu com a Selic subindo e descendo", "showTitle": true,
                        "showDescription": true, "description": "Barras: valor liquidado via Pix no mes. Linha: media mensal da meta Selic. O volume do Pix nao acompanha o ciclo de juros."}
            }

# Copie para .env e preencha. O .env nunca entra no Git.
# As APIs do Banco Central sao publicas e nao exigem chave.
# A autenticacao do Databricks fica no perfil da CLI (~/.databrickscfg), fora do repositorio.

# Perfil da CLI do Databricks usado pelos scripts locais (databricks auth login --profile ...)
DATABRICKS_CONFIG_PROFILE=pix-macro

# Pasta local onde os JSONs brutos sao salvos antes de subir ao Volume
PASTA_DADOS_BRUTOS=data/raw

/// Modelo semantico do projeto pix-macro-lakehouse. Le as tabelas gold do Databricks
/// (catalogo workspace, schema pix_macro_gold) pelo conector Databricks em modo Import.
model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	discourageImplicitMeasures

ref table indicadores_mensais
ref table pix_uf_mensal
ref table pix_capital_interior_mensal


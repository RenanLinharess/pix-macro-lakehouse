/// Cada UF/mes aponta para o mes da tabela de indicadores (uma linha por mes).
relationship uf_para_indicadores
	fromColumn: pix_uf_mensal.data_referencia
	toColumn: indicadores_mensais.data_referencia

relationship capital_interior_para_indicadores
	fromColumn: pix_capital_interior_mensal.data_referencia
	toColumn: indicadores_mensais.data_referencia

